# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://weyxewesdowmknygynys.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://cazotaskai.com

# ---- AI (required for real AI steps; without it runs use the sample engine) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---- Stripe (test keys are fine to launch with) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ---- Slack OAuth (optional, enables live Slack automations) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Credential encryption (required before any account can be connected) ----
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored connection token unrecoverable.
TOKEN_ENCRYPTION_KEY=

# ---- Cron protection ----
CRON_SECRET=
